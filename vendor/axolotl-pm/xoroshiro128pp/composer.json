{
    "name": "axolotl-pm/xoroshiro128pp",
    "description": "Xoroshiro128++ random number generator for PocketMine-MP",
    "type": "library",
    "license": "LGPL-3.0",
    "version": "0.1.0",
    "require": {
        "php": "^8.1",
        "php-64bit": "*",
        "ext-gmp": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "2.2.8",
        "phpstan/phpstan-phpunit": "^2.0.0",
        "phpstan/phpstan-strict-rules": "^2.0.0",
        "phpunit/phpunit": "^10.5.24"
    },
    "autoload": {
        "psr-4": {
            "pocketmine\\xoroshiro128pp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "pocketmine\\xoroshiro128pp\\": "tests/phpunit/"
        }
    }
}
